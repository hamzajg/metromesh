{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "RegistryTopic": "equipment.registry.v1"
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalMs": 1000,
    "BatchSize": 50
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Maintenance": {
    "Registry": {
      "BaseUrl": "http://localhost:8082"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "MaintenanceTopic": "maintenance.workorder.v1"
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalMs": 1000,
    "BatchSize": 50
  }
}
